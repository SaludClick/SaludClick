generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique @db.VarChar(100)
  descripcion  String?       @db.VarChar(255)
  created_at   DateTime?     @default(now()) @db.Timestamp(0)
  updated_at   DateTime?     @default(now()) @db.Timestamp(0)
  medicamentos Medicamento[]

  @@map("categorias")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  afiliado Afiliado? @relation("CuentaAfiliado")
  afiliados_verificados Afiliado[] @relation("VerificadorAfiliado")
  id                       Int                 @id @default(autoincrement())
  nombre                   String              @db.VarChar(100)
  apellido                 String              @db.VarChar(100)
  correo                   String              @unique @db.VarChar(150)
  telefono                 String?             @db.VarChar(20)
  cedula                   String?             @unique @db.VarChar(30)
  tipo_documento           String?             @db.VarChar(10)
  ciudad                   String?             @db.VarChar(100)
  password                 String              @db.VarChar(255)
  rol_id                   Int
  estado                   EstadoUsuario?      @default(ACTIVO)
  created_at               DateTime?           @default(now()) @db.Timestamp(0)
  updated_at               DateTime?           @default(now()) @db.Timestamp(0)
  pagos                    Pago[]
  recordatorios            Recordatorio[]
  solicitudes              Solicitud[]
  tokens_recuperacion      TokenRecuperacion[]
  formulas_medicas         FormulaMedica[]
  conversaciones_cliente   Conversacion[]      @relation("ConversacionCliente")
  conversaciones_asignadas Conversacion[]      @relation("ConversacionAgente")
  mensajes_chat            MensajeChat[]
  auditorias_pacientes_autorizados AuditoriaPacienteAutorizado[] @relation("AuditoriaAdministrador")
  rol                      Rol                 @relation(fields: [rol_id], references: [id])

  @@index([rol_id])
  @@map("usuarios")
}

// Los 13 valores del CSV se conservan como texto, sin normalización.
model Afiliado {
  id String @id
  nombres String
  apellidos String
  tipo_documento String
  documento String @unique
  fecha_nacimiento String
  telefono String
  correo String
  direccion String
  ciudad String
  regimen String
  estado String
  eps_id String
  usuario_id Int? @unique
  verificado_por Int?
  verificado_at DateTime?
  usuario Usuario? @relation("CuentaAfiliado", fields: [usuario_id], references: [id], onDelete: Restrict)
  verificador Usuario? @relation("VerificadorAfiliado", fields: [verificado_por], references: [id], onDelete: Restrict)

  @@map("afiliados")
}

model Medicamento {
  id                         Int                 @id @default(autoincrement())
  nombre                     String              @db.VarChar(150)
  descripcion                String?
  categoria_id               Int
  precio                     Decimal             @db.Decimal(10, 2)
  stock                      Int                 @default(0)
  imagen                     String?             @db.VarChar(255)
  estado                     EstadoMedicamento?  @default(DISPONIBLE)
  codigo_fuente              String?             @unique @db.VarChar(80)
  expediente                 String?             @db.VarChar(40)
  nombre_generico            String?             @db.VarChar(180)
  principio_activo           String?
  concentracion              String?             @db.VarChar(120)
  forma_farmaceutica         String?             @db.VarChar(120)
  presentacion               String?             @db.VarChar(180)
  via_administracion         String?             @db.VarChar(120)
  titular_registro           String?             @db.VarChar(220)
  registro_sanitario         String?             @db.VarChar(100)
  estado_registro_invima     String?             @db.VarChar(80)
  modalidad_comercializacion String?             @db.VarChar(180)
  cum                        String?             @db.VarChar(80)
  ium                        String?             @db.VarChar(80)
  requiere_formula           Boolean?
  catalogo_verificado        Boolean             @default(false)
  precio_referencial         Decimal?            @db.Decimal(12, 2)
  fuente_precio              String?             @db.VarChar(80)
  fecha_precio               DateTime?           @db.Date
  created_at                 DateTime?           @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?           @default(now()) @db.Timestamp(0)
  detalles_solicitud         DetalleSolicitud[]
  categoria                  Categoria           @relation(fields: [categoria_id], references: [id])
  recordatorios              Recordatorio[]
  imagenes                   ImagenMedicamento[]
  observaciones_precio       ObservacionPrecio[]

  @@index([categoria_id])
  @@index([estado])
  @@index([nombre])
  @@index([principio_activo])
  @@index([registro_sanitario])
  @@index([estado_registro_invima])
  @@map("medicamentos")
}

model ImagenMedicamento {
  id             Int         @id @default(autoincrement())
  medicamento_id Int
  url            String      @db.VarChar(500)
  texto_alt      String?     @db.VarChar(255)
  es_principal   Boolean     @default(false)
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  medicamento    Medicamento @relation(fields: [medicamento_id], references: [id], onDelete: Cascade)

  @@index([medicamento_id])
  @@map("imagenes_medicamento")
}

model ObservacionPrecio {
  id             Int         @id @default(autoincrement())
  medicamento_id Int
  valor          Decimal     @db.Decimal(12, 2)
  moneda         String      @default("COP") @db.VarChar(3)
  fuente         String      @db.VarChar(80)
  fecha_corte    DateTime    @db.Date
  notas          String?
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  medicamento    Medicamento @relation(fields: [medicamento_id], references: [id], onDelete: Cascade)

  @@index([medicamento_id, fecha_corte])
  @@map("observaciones_precio")
}

model Solicitud {
  id               Int                @id @default(autoincrement())
  usuario_id       Int
  fecha            DateTime?          @default(now()) @db.Timestamp(0)
  estado           EstadoSolicitud?   @default(PENDIENTE)
  tipo_entrega     TipoEntrega?       @default(RECOGER)
  direccion        String?            @db.VarChar(255)
  observaciones    String?
  idempotency_key  String?            @db.Uuid
  idempotency_hash String?            @db.Char(64)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  detalles         DetalleSolicitud[]
  pagos            Pago[]
  usuario          Usuario            @relation(fields: [usuario_id], references: [id])

  @@unique([usuario_id, idempotency_key], map: "solicitudes_usuario_id_idempotency_key_key")
  @@index([usuario_id])
  @@index([estado])
  @@map("solicitudes")
}

model DetalleSolicitud {
  id             Int         @id @default(autoincrement())
  solicitud_id   Int
  medicamento_id Int
  cantidad       Int
  precio         Decimal     @db.Decimal(10, 2)
  subtotal       Decimal     @db.Decimal(10, 2)
  created_at     DateTime?   @default(now()) @db.Timestamp(0)
  medicamento    Medicamento @relation(fields: [medicamento_id], references: [id])
  solicitud      Solicitud   @relation(fields: [solicitud_id], references: [id])

  @@index([solicitud_id])
  @@index([medicamento_id])
  @@map("detalle_solicitud")
}

model Pago {
  id              Int        @id @default(autoincrement())
  solicitud_id    Int
  usuario_id      Int
  referencia      String     @unique @db.VarChar(80)
  metodo          MetodoPago
  marca           String     @db.VarChar(30)
  ultimos_digitos String     @db.Char(4)
  monto           Decimal    @db.Decimal(10, 2)
  estado          EstadoPago
  simulacion      Boolean    @default(true)
  created_at      DateTime?  @default(now()) @db.Timestamp(0)
  solicitud       Solicitud  @relation(fields: [solicitud_id], references: [id])
  usuario         Usuario    @relation(fields: [usuario_id], references: [id])

  @@index([solicitud_id])
  @@index([usuario_id])
  @@map("pagos")
}

model Recordatorio {
  id             Int                    @id @default(autoincrement())
  usuario_id     Int
  medicamento_id Int
  hora           DateTime               @db.Time(0)
  frecuencia     FrecuenciaRecordatorio
  fecha_inicio   DateTime               @db.Date
  fecha_fin      DateTime?              @db.Date
  estado         EstadoRecordatorio?    @default(ACTIVO)
  created_at     DateTime?              @default(now()) @db.Timestamp(0)
  updated_at     DateTime?              @default(now()) @db.Timestamp(0)
  medicamento    Medicamento            @relation(fields: [medicamento_id], references: [id])
  usuario        Usuario                @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([medicamento_id])
  @@map("recordatorios")
}

model TokenRecuperacion {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  token_hash String    @unique @db.Char(64)
  expira_en  DateTime  @db.Timestamp(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  usuario    Usuario   @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([expira_en])
  @@map("tokens_recuperacion")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum EstadoMedicamento {
  DISPONIBLE
  AGOTADO
  INACTIVO
}

enum MetodoPago {
  TARJETA
}

enum EstadoPago {
  APROBADO
  RECHAZADO
  PENDIENTE
}

enum FrecuenciaRecordatorio {
  CADA_8_HORAS
  CADA_12_HORAS
  CADA_24_HORAS
}

enum EstadoRecordatorio {
  ACTIVO
  INACTIVO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  PREPARANDO
  LISTA
  ENTREGADA
  CANCELADA
}

enum TipoEntrega {
  RECOGER
  DOMICILIO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoPacienteAutorizado {
  AUTORIZADO
  REVOCADO
}

model PacienteAutorizado {
  id              Int                         @id @default(autoincrement())
  nombres         String                      @db.VarChar(100)
  apellidos       String                      @db.VarChar(100)
  tipo_documento  String                      @db.VarChar(10)
  cedula          String                      @unique @db.VarChar(30)
  estado          EstadoPacienteAutorizado    @default(AUTORIZADO)
  created_at      DateTime                    @default(now()) @db.Timestamp(0)
  updated_at      DateTime                    @updatedAt @db.Timestamp(0)
  auditorias      AuditoriaPacienteAutorizado[]

  @@index([estado])
  @@index([apellidos, nombres])
  @@map("pacientes_autorizados")
}

model AuditoriaPacienteAutorizado {
  id                Int                @id @default(autoincrement())
  paciente_id       Int
  administrador_id  Int
  accion            String             @db.VarChar(30)
  campos_modificados String[]           @default([])
  created_at        DateTime           @default(now()) @db.Timestamp(0)
  paciente          PacienteAutorizado @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  administrador     Usuario            @relation("AuditoriaAdministrador", fields: [administrador_id], references: [id], onDelete: Restrict)

  @@index([paciente_id, created_at])
  @@index([administrador_id, created_at])
  @@map("auditorias_pacientes_autorizados")
}

model FormulaMedica {
  id              Int      @id @default(autoincrement())
  usuario_id      Int
  nombre_archivo  String   @db.VarChar(255)
  nombre_original String   @db.VarChar(180)
  tipo_mime       String   @db.VarChar(100)
  ruta_archivo    String   @db.VarChar(500)
  tamano          Int
  descripcion     String?
  estado          String   @default("PENDIENTE") @db.VarChar(20)
  fecha_subida    DateTime @default(now()) @db.Timestamp(0)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([estado])
  @@map("formulas_medicas")
}

model Conversacion {
  id         Int           @id @default(autoincrement())
  cliente_id Int
  agente_id  Int?
  estado     EstadoChat    @default(ABIERTA)
  created_at DateTime      @default(now()) @db.Timestamp(0)
  updated_at DateTime      @updatedAt @db.Timestamp(0)
  cliente    Usuario       @relation("ConversacionCliente", fields: [cliente_id], references: [id], onDelete: Cascade)
  agente     Usuario?      @relation("ConversacionAgente", fields: [agente_id], references: [id], onDelete: SetNull)
  mensajes   MensajeChat[]

  @@index([cliente_id, updated_at])
  @@index([agente_id, estado, updated_at])
  @@map("conversaciones")
}

model MensajeChat {
  id              Int           @id @default(autoincrement())
  conversacion_id Int
  remitente_id    Int
  contenido       String        @db.VarChar(2000)
  estado          EstadoMensaje @default(ENVIADO)
  created_at      DateTime      @default(now()) @db.Timestamp(0)
  entregado_at    DateTime?     @db.Timestamp(0)
  leido_at        DateTime?     @db.Timestamp(0)
  conversacion    Conversacion  @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  remitente       Usuario       @relation(fields: [remitente_id], references: [id], onDelete: Cascade)

  @@index([conversacion_id, created_at])
  @@index([remitente_id])
  @@map("mensajes_chat")
}

enum EstadoChat {
  ABIERTA
  CERRADA
}

enum EstadoMensaje {
  ENVIADO
  ENTREGADO
  LEIDO
}
