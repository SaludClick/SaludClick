BACKEND_URL=http://localhost:3000
RECAPTCHA_SECRET_KEY=replace-with-google-recaptcha-v2-secret
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional maintenance allowlist. Both values are required only when running
# invitation, activation or authorized-account verification scripts.
# Configure real addresses privately; never commit the configured .env.
AUTHORIZED_FARMACIA_EMAIL=
AUTHORIZED_EPS_EMAIL=

# Optional maintenance guards and historical archive location (private).
AFILIADOS_EXPECTED_HOST=
EPS_HISTORICAL_ARCHIVE=
