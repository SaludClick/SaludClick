---
import Layout from './Layout.astro';
const { modulo, titulo, descripcion = '' } = Astro.props;
const dashboard = modulo === 'dashboard';
const enlaces = [
  ['dashboard', 'Dashboard', '/pages/farmacia.html', 'fa-gauge-high'],
  ['solicitudes', 'Solicitudes', '/pages/farmacia-solicitudes.html', 'fa-clipboard-list'],
  ['usuarios', 'Usuarios', '/pages/farmacia-usuarios.html', 'fa-user-group'],
  ['inventario', 'Inventario', '/pages/farmacia-inventario.html', 'fa-boxes-stacked'],
  ['medicamentos', 'Medicamentos', '/pages/farmacia-medicamentos.html', 'fa-capsules'],
  ['notificaciones', 'Notificaciones', '/pages/farmacia-notificaciones.html', 'fa-bell'],
  ['perfil', 'Perfil', '/pages/farmacia-perfil.html', 'fa-circle-user']
];
---
<Layout title={`${titulo} | Farmacia | SaludClick`} bodyClass={dashboard ? 'admin-console farmacia-dashboard-page' : 'admin-console'}>
  <Fragment slot="head"><link rel="stylesheet" href="/css/farmacia.css" /><link rel="stylesheet" href="/css/panel-menu.css" /><slot name="head" /></Fragment>
  <div class="admin-app" data-panel-menu="farmacia" id="farmaciaApp" data-farmacia-module={modulo}>
    <aside class="admin-sidebar panel-sidebar" id="menu" aria-label="Navegación de farmacia">
      <button class="admin-menu-toggle panel-menu-close" type="button" data-panel-close aria-label="Cerrar menú"><span class="panel-menu-icon" aria-hidden="true"></span></button>
      <a href="/pages/farmacia.html" class="admin-brand"><span class="admin-brand-mark"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></span><span>SaludClick<small>FARMACIA</small></span></a>
      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones de farmacia">
        {enlaces.map(([clave, texto, ruta, icono]) => <a class:list={['admin-side-link', { active: clave === modulo }]} href={ruta} aria-current={clave === modulo ? 'page' : undefined} data-farmacia-link={clave} id={clave === 'notificaciones' ? 'farmaciaNotificationsBell' : undefined}><i class={`fa-solid ${icono}`} aria-hidden="true"></i><span>{texto}</span>{clave === 'notificaciones' && <small id="farmaciaNotificationsBadge" class="panel-sidebar-badge" aria-hidden="true">—</small>}</a>)}
      </nav>
      <div hidden><span id="farmaciaUserName">Farmacia</span>{dashboard && <><span id="farmaciaDashboardAvatar"></span><span id="farmaciaDashboardAccountName">Farmacia</span></>}</div>
      <div class="admin-sidebar-bottom">
        <button class="admin-logout" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>
    <div class="panel-menu-backdrop" data-panel-backdrop aria-hidden="true"></div>
    <div class="admin-main">
      <header class="admin-topbar panel-topbar">
        <button class="admin-menu-toggle" id="menuToggle" type="button" aria-label="Abrir menú de farmacia" aria-expanded="false" aria-controls="menu"><span class="panel-menu-icon" aria-hidden="true"></span></button>
        <saludclick-theme-control></saludclick-theme-control>
      </header>
      <p id="farmaciaAccessStatus" class="admin-message" role="status" aria-live="polite">Verificando acceso de Farmacia…</p>
      <main class="admin-content farmacia-main" id="farmaciaMain" hidden>
        <header class="admin-page-heading"><div>{!dashboard && modulo !== "medicamentos" && <span class="admin-eyebrow">OPERACIÓN DE FARMACIA</span>}<h1 id={modulo === "medicamentos" ? "farmaciaMedicamentosTitle" : undefined}>{titulo}</h1>{(modulo !== "medicamentos" || descripcion) && <p>{descripcion}</p>}</div><button id="refreshFarmacia" class="btn-outline admin-refresh" type="button" hidden={['usuarios', 'perfil', 'medicamentos'].includes(modulo)}>Actualizar</button></header>
        <div id="farmaciaMessage" class="admin-message" role="status" aria-live="polite"></div>
        <p hidden={modulo === "medicamentos"} id="farmaciaLinkedEps" role="status" aria-live="polite">Consultando EPS vinculada…</p>
        <slot />
      </main>
    </div>
  </div>
  <script is:inline type="module" src="/js/panel-menu.js"></script>
  <script is:inline type="module" src="/js/farmacia.js"></script>
</Layout>
