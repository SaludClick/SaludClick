<section id="pedidosFarmacia" class="farmacia-orders-panel" aria-labelledby="pedidosTitle" tabindex="-1">
  <h2 id="pedidosTitle">Solicitudes de Farmacia</h2>
  <p>Consulta la cola operativa y sus medicamentos. Los avances exigen pago real aprobado. Los medicamentos que requieren fórmula o tienen ese requisito sin determinar permanecen bloqueados.</p>
  <p><a href="/pages/farmacia.html#integracionEPS">Consultar las autorizaciones EPS asignadas a tu farmacia</a></p>
  <div class="farmacia-orders-stats" aria-label="Indicadores de solicitudes">
    <article><strong data-order-count="pendientes">—</strong><span>Pendientes de preparar</span></article><article><strong data-order-count="preparando">—</strong><span>En preparación</span></article>
    <article><strong data-order-count="listas">—</strong><span>Listas</span></article>
    <article><strong data-order-count="entregadas">—</strong><span>Entregadas</span></article>
  </div>
  <p class="farmacia-orders-note">Totales de la cola, independientes de los filtros. Pendientes de preparar corresponde a solicitudes aprobadas; no incluye solicitudes pendientes de aprobación.</p>
  <p id="farmaciaOrdersSummaryStatus" role="status" aria-live="polite"></p>
  <form id="filtroPedidos" class="farmacia-filters">
    <label for="documentoSolicitudFarmacia">Buscar por cédula (CC)</label>
    <input id="documentoSolicitudFarmacia" name="documento" type="search" inputmode="numeric" maxlength="30" placeholder="Ingresa el número de cédula" />
    <label for="buscarSolicitudFarmacia">Identificador de solicitud</label>
    <input id="buscarSolicitudFarmacia" name="id" inputmode="numeric" maxlength="10" pattern="[1-9][0-9]{0,9}" />
    <label for="estadoFarmacia">Estado</label>
    <select id="estadoFarmacia" name="estado">
      <option value="todas">Todas las operativas</option>
      <option value="APROBADA">Aprobadas</option>
      <option value="PREPARANDO">En preparación</option>
      <option value="LISTA">Listas</option>
      <option value="ENTREGADA">Entregadas</option>
    </select>
    <button type="submit" id="farmaciaOrdersRefresh">Buscar</button>
    <button type="button" id="farmaciaOrdersClear">Borrar búsqueda</button>
  </form>
  <button id="retryFarmaciaOrders" type="button" hidden>Reintentar consulta de pedidos</button>
  <button id="retryFarmaciaStats" type="button" hidden>Reintentar indicadores</button>
  <p id="farmaciaOrdersStatus" role="status" aria-live="polite"></p>
  <div id="farmaciaOrders" aria-live="polite" aria-busy="false"></div>
  <nav class="farmacia-pagination" aria-label="Páginas de solicitudes"><button type="button" id="ordersPrevious" disabled>Anterior</button><span id="ordersPage"></span><button type="button" id="ordersNext" disabled>Siguiente</button></nav>
  <dialog id="farmaciaSolicitudDetalle" class="farmacia-orders-dialog" aria-labelledby="farmaciaSolicitudDetalleTitle">
    <div class="farmacia-orders-dialog-heading"><h2 id="farmaciaSolicitudDetalleTitle">Detalle de solicitud</h2><button id="farmaciaSolicitudCerrar" type="button">Cerrar detalle</button></div>
    <div id="farmaciaSolicitudDetalleContent" aria-busy="false"></div>
  </dialog>
  <dialog id="farmaciaSolicitudConfirmacion" class="farmacia-orders-dialog" aria-labelledby="farmaciaSolicitudConfirmacionTitle">
    <h2 id="farmaciaSolicitudConfirmacionTitle">Confirmar cambio de estado</h2>
    <p id="farmaciaSolicitudConfirmacionText"></p>
    <label for="farmaciaSolicitudRecepcion">Recepción confirmada (obligatoria para entrega)</label><input id="farmaciaSolicitudRecepcion" type="text" maxlength="500" placeholder="Constancia autorizada de recepción" />
    <label for="farmaciaSolicitudObservaciones">Observaciones del cambio</label><textarea id="farmaciaSolicitudObservaciones" maxlength="500" rows="3"></textarea>
    <p>El servidor volverá a comprobar el estado, el pago y las condiciones de los medicamentos.</p>
    <div class="farmacia-order-actions"><button id="farmaciaSolicitudCancelar" type="button">Cancelar</button><button id="farmaciaSolicitudConfirmar" type="button">Confirmar cambio</button></div>
  </dialog>
</section>
<style is:global>
  .farmacia-requests-table :is(th, td) { vertical-align: top; }
  .farmacia-requests-table :is(h3, h4, p) { margin: 0 0 .4rem; }
  .farmacia-requests-table .farmacia-order-actions { gap: .35rem; }
  .farmacia-requests-table ul { margin: 0; }
  @media (max-width: 900px) {
    .farmacia-requests-table td > div { min-width: 0; }
  }
  .farmacia-formula-actions button { margin: .25rem .5rem .25rem 0; }
  .farmacia-formula-actions [role="status"]:empty { display: none; }
  .farmacia-order-resumen {
    width: 100%;
    border-collapse: collapse;
    margin-block: .75rem;
    text-align: left;
  }
  .farmacia-order-resumen caption { text-align: left; font-weight: 700; }
  .farmacia-order-resumen :is(th, td) { padding: .35rem .5rem; border-bottom: 1px solid #d6e2dd; overflow-wrap: anywhere; }
  .farmacia-order-resumen :is(th, td):last-child { width: 7rem; text-align: right; }
  @media (max-width: 900px) {
    #pedidosFarmacia .farmacia-order-items { min-width: 0; }
  }
  @media (max-width: 480px) {
    .farmacia-order-resumen :is(th, td):last-child { width: 5rem; }
  }
</style>
