    <section id="pedidosFarmacia" aria-labelledby="pedidosTitle" tabindex="-1">
      <h2 id="pedidosTitle">Pedidos para atender</h2>
      <p>Los pedidos avanzan de aprobado a preparando, listo y entregado. Solo se actualizan pedidos con pago aprobado.</p>
      <form id="filtroPedidos" class="farmacia-filters">
        <label for="estadoFarmacia">Estado</label><select id="estadoFarmacia">
          <option value="">Activos</option><option value="APROBADA">Aprobados</option><option value="PREPARANDO">Preparando</option><option value="LISTA">Listos</option><option value="ENTREGADA">Entregados</option>
        </select><button type="submit">Aplicar filtro</button>
      </form>
      <p id="ordersAppliedFilter">Vista: pedidos activos · Más antiguos primero</p>
      <p id="ordersMessage" role="status" aria-live="polite"></p>
      <button id="retryFarmaciaOrders" type="button" hidden>Reintentar consulta de pedidos</button>
      <div id="farmaciaOrders" aria-live="polite" aria-busy="false"></div>
      <div class="farmacia-pagination"><button type="button" id="ordersPrevious" disabled>Anterior</button><span id="ordersPage"></span><button type="button" id="ordersNext" disabled>Siguiente</button></div>
    </section>
    <section id="inventarioFarmacia" aria-labelledby="inventarioTitle" tabindex="-1">
      <h2 id="inventarioTitle">Consulta de inventario</h2><p>Solo consulta. El estado del registro y las unidades en stock son datos distintos.</p>
      <form id="buscarInventario" class="farmacia-filters"><label for="buscarFarmacia">Medicamento</label><input id="buscarFarmacia" type="search" maxlength="150" placeholder="Buscar por nombre"><button type="submit">Buscar</button><button type="button" id="clearFarmaciaInventory">Limpiar búsqueda</button></form>
      <p id="inventoryAppliedSearch">Todos los medicamentos</p>
      <div class="farmacia-table" tabindex="0" role="region" aria-label="Resultados del inventario"><table><caption>Existencias de medicamentos</caption><thead><tr><th scope="col">Medicamento</th><th scope="col">Categoría</th><th scope="col">Unidades en stock</th><th scope="col">Estado del registro</th></tr></thead><tbody id="farmaciaInventory"></tbody></table></div>
      <p id="inventoryEmpty" role="status"></p>
      <p id="inventoryMessage" role="status" aria-live="polite"></p>
      <button id="retryFarmaciaInventory" type="button" hidden>Reintentar inventario</button>
      <div class="farmacia-pagination"><button type="button" id="inventoryPrevious" disabled>Anterior</button><span id="inventoryPage"></span><button type="button" id="inventoryNext" disabled>Siguiente</button></div>
    </section>
