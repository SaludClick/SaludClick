---
const { personal = false } = Astro.props;
const Group = personal ? 'fieldset' : 'div';
---
<form id="perfilFormulario" aria-busy="true">
    <div class:list={['perfil-grid', { 'profile-groups': personal }]}>
        <Group style={personal ? undefined : 'display: contents'}>
            {personal && <legend>Información personal</legend>}
            <div class="campo">
                <label for="nombre">Nombres</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input id="nombre" name="nombre" type="text" autocomplete="given-name" maxlength="100" required disabled>
                </div>
            </div>
            <div class="campo">
                <label for="apellido">Apellidos</label>
                <input id="apellido" name="apellido" type="text" autocomplete="family-name" maxlength="100" required disabled>
            </div>
            <div class="campo">
                <label for="tipoDocumento">Tipo Documento</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-address-card input-icon"></i>
                    <input id="tipoDocumento" name="tipoDocumento" type="text" maxlength="10" placeholder="Ej. CC" disabled>
                </div>
            </div>
            <div class="campo">
                <label for="numeroDocumento">Número Documento</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-hashtag input-icon"></i>
                    <input id="numeroDocumento" name="numeroDocumento" type="text" maxlength="30" placeholder="Ej. 1020304050" disabled>
                </div>
            </div>
        </Group>
        <Group style={personal ? undefined : 'display: contents'}>
            {personal && <legend>Información de contacto</legend>}
            <div class="campo">
                <label for="email">Correo Electrónico</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-envelope input-icon"></i>
                    <input id="email" type="email" placeholder="ejemplo@correo.com" required readonly aria-describedby="correoSoloLectura">
                    <small id="correoSoloLectura">El correo de la cuenta no se modifica desde el perfil.</small>
                </div>
            </div>
            <div class="campo">
                <label for="telefono">Teléfono</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-phone input-icon"></i>
                    <input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="20" placeholder="Ej. 3001234567" disabled>
                </div>
            </div>
            <div class="campo">
                <label for="ciudad">Ciudad</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-city input-icon"></i>
                    <input id="ciudad" name="ciudad" type="text" autocomplete="address-level2" maxlength="100" placeholder="Ej. Medellín" disabled>
                </div>
            </div>
        </Group>
    </div>
    <div class="profile-actions-wrapper">
        <button id="guardarPerfil" type="submit" class="btn-guardar" disabled>
            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar cambios
        </button>

        <button id="cancelarPerfil" type="button" class="btn-outline" disabled>
            Cancelar
        </button>
        <button id="reintentarPerfil" type="button" class="btn-outline" hidden>Reintentar</button>
    </div>

    <p id="mensajePerfil" role="status" aria-live="polite" class="mensaje-estado"></p>
</form>
