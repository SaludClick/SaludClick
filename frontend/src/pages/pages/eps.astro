---
import Layout from "../../layouts/Layout.astro";

const title = "Dashboard EPS | SaludClick";
---

<Layout title={title} bodyClass="admin-console">
  <div class="admin-app">
    <aside class="admin-sidebar" id="menu" aria-label="Navegación EPS">
      <a href="/pages/eps.html" class="admin-brand" aria-label="SaludClick, dashboard EPS">
        <span class="admin-brand-mark">
          <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        </span>
        <span>SaludClick<small>EPS</small></span>
      </a>

      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones EPS">
        <a class="admin-side-link active" href="/pages/eps.html" aria-current="page">
          <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
          <span>Dashboard</span>
        </a>
        <span class="admin-side-link eps-nav-disabled" aria-disabled="true" title="Esta operación aún no está habilitada para EPS.">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          <span>Afiliados</span>
          <small>No disponible</small>
        </span>
        <span class="admin-side-link eps-nav-disabled" aria-disabled="true" title="Esta operación aún no está habilitada para EPS.">
          <i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i>
          <span>Farmacias</span>
          <small>No disponible</small>
        </span>
        <span class="admin-side-link eps-nav-disabled" aria-disabled="true" title="Esta operación aún no está habilitada para EPS.">
          <i class="fa-solid fa-file-circle-check" aria-hidden="true"></i>
          <span>Autorizaciones</span>
          <small>No disponible</small>
        </span>
        <span class="admin-side-link eps-nav-disabled" aria-disabled="true" title="Esta operación aún no está habilitada para EPS.">
          <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
          <span>Solicitudes</span>
          <small>No disponible</small>
        </span>
        <a class="admin-side-link" href="/pages/perfil.html">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
          <span>Perfil</span>
        </a>
      </nav>

      <div class="admin-sidebar-bottom">
        <div class="admin-sidebar-user">
          <span class="admin-avatar"><i class="fa-solid fa-hospital" aria-hidden="true"></i></span>
          <span><strong id="epsUserName">EPS</strong><small>Personal EPS</small></span>
        </div>
        <button class="admin-logout" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="admin-menu-toggle"
          id="menuToggle"
          type="button"
          aria-label="Abrir menú EPS"
          aria-expanded="false"
          aria-controls="menu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="admin-topbar-copy">
          <span>SaludClick</span>
          <strong>Panel EPS</strong>
        </div>
        <div class="admin-topbar-status">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          Acceso EPS
        </div>
      </header>

      <main class="admin-content" id="epsMain">
        <section class="admin-page-heading">
          <div>
            <span class="admin-eyebrow">OPERACIÓN EPS</span>
            <h1>Dashboard</h1>
            <p>Los módulos de afiliados, farmacias, autorizaciones y solicitudes están deshabilitados hasta contar con endpoints operativos y permisos definidos.</p>
          </div>
          <button id="refreshEps" class="btn-outline admin-refresh" type="button">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
            Verificar acceso
          </button>
        </section>

        <div id="epsMessage" class="admin-message" role="status" aria-live="polite"></div>

        <section class="card admin-dashboard-card eps-access-card" aria-live="polite">
          <span class="admin-eyebrow">ESTADO DE SESIÓN</span>
          <div class="eps-access-indicator" id="epsAccess" aria-busy="true">
            <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
            <span>Verificando permisos...</span>
          </div>
          <p>Este panel no muestra estadísticas porque todavía no hay endpoints EPS para consultar datos operativos.</p>
        </section>
      </main>
    </div>
  </div>

  <script is:inline type="module" src="/js/menu.js"></script>
  <script is:inline type="module" src="/js/eps.js"></script>
</Layout>

<style>
  .eps-nav-disabled {
    cursor: not-allowed;
    opacity: 0.62;
  }

  .eps-nav-disabled small {
    margin-left: auto;
    color: #a7c7b7;
    font-size: 9px;
    white-space: nowrap;
  }

  .eps-access-card {
    margin-top: 20px;
  }

  .eps-access-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 18px 0 10px;
    color: #526a5e;
    font-size: 15px;
    font-weight: 700;
  }

  .eps-access-indicator i {
    color: var(--admin-green);
    font-size: 20px;
  }

  .eps-access-card > p {
    margin: 0;
    color: var(--admin-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 620px) {
    .eps-nav-disabled small {
      display: none;
    }
  }
</style>
