---
import Layout from "../../layouts/Layout.astro";
import Chat from "../../components/Chat.jsx";
const title = "VITALIX | Asistente de acceso | SaludClick";
---
<Layout title={title} bodyClass="">
  <Fragment slot="head">
    <meta
      name="description"
      content="VITALIX ofrece orientación sobre solicitudes de acceso y soporte de cuentas de SaludClick."
    />
  </Fragment>
  <header class="navbar">
    <div class="container nav-container">
      <a href="/" class="logo" aria-label="SaludClick, inicio">
        <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        <span>SaludClick</span>
      </a>
      <button
        type="button"
        id="menuToggle"
        class="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <nav class="main-nav" id="menu" aria-label="Navegación">
        <a class="nav-link" href="/"><i class="fa-solid fa-house" aria-hidden="true"></i>Inicio</a>
        <a class="nav-link active" href="/pages/chat.html" aria-current="page">
          <i class="fa-solid fa-comments" aria-hidden="true"></i>VITALIX
        </a>
        <button
          type="button"
          id="logout"
          class="nav-link logout-link"
          hidden
        >
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          Cerrar sesión
        </button>
      </nav>
    </div>
  </header>
  <Chat client:load />
  <script is:inline type="module" src="/js/menu.js"></script>
  <script is:inline type="module" src="/js/main.js"></script>
  <script is:inline type="module">
    import { getToken } from "/js/auth.js";
    if (getToken()) document.getElementById("logout")?.removeAttribute("hidden");
  </script>
</Layout>
