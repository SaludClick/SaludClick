---
import Layout from "../../layouts/Layout.astro";

const title = "Dashboard EPS | SaludClick";
---

<Layout title={title} bodyClass="admin-console eps-console">
  <Fragment slot="head"><link rel="stylesheet" href="/css/eps.css" /><link rel="stylesheet" href="/css/panel-menu.css" /></Fragment>
  <div class="admin-app" data-panel-menu="eps">
    <aside class="admin-sidebar" id="menu" aria-label="Navegación EPS">
      <button class="admin-menu-toggle panel-menu-close" type="button" data-panel-close aria-label="Cerrar men&#250;"><span class="panel-menu-icon" aria-hidden="true"></span></button>
      <a href="/pages/eps.html" class="admin-brand" aria-label="SaludClick, dashboard EPS">
        <span class="admin-brand-mark">
          <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        </span>
        <span>SaludClick<small>EPS</small></span>
      </a>

      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones EPS">
        <a class="admin-side-link active" href="#dashboard" data-eps-view="dashboard" aria-current="page">
          <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
          <span>Dashboard</span>
        </a>
        <a class="admin-side-link" href="#afiliados" data-eps-view="afiliados"><i class="fa-solid fa-users" aria-hidden="true"></i><span>Afiliados</span></a>
        <a class="admin-side-link" href="#farmacias" data-eps-view="farmacias"><i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i><span>Farmacias</span></a>
        <a class="admin-side-link" href="#solicitudes" data-eps-view="solicitudes"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i><span>Solicitudes</span></a>
        <a class="admin-side-link" href="#inventario" data-eps-view="inventario"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><span>Inventario</span></a>
        <a class="admin-side-link" href="#notificaciones" data-eps-view="notificaciones"><i class="fa-solid fa-bell" aria-hidden="true"></i><span>Notificaciones</span></a>
        <a class="admin-side-link" href="#perfil" data-eps-view="perfil">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
          <span>Perfil</span>
        </a>
      </nav>

      <div class="admin-sidebar-bottom">
        <div class="admin-sidebar-user">
          <span class="admin-avatar"><i class="fa-solid fa-hospital" aria-hidden="true"></i></span>
          <span><strong id="epsUserName">EPS</strong><small>Personal EPS</small></span>
        </div>
        <button class="admin-logout" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="panel-menu-backdrop" data-panel-backdrop aria-hidden="true"></div>
    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="admin-menu-toggle"
          id="menuToggle"
          type="button"
          aria-label="Abrir menú EPS"
          aria-expanded="false"
          aria-controls="menu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="admin-topbar-copy">
          <span>SaludClick</span>
          <strong>Panel EPS</strong>
        </div>
        <div class="eps-topbar-actions">
          <button id="epsBell" type="button" class="btn-outline" aria-label="Ver notificaciones">
            <i class="fa-solid fa-bell" aria-hidden="true"></i>
            <span id="epsUnread">–</span>
          </button>
          <div class="admin-topbar-status">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
            <span>Acceso EPS</span>
          </div>
        </div>
      </header>

      <main class="admin-content" id="epsMain">
        <section class="admin-page-heading" aria-labelledby="epsTitle">
          <div>
            <span class="admin-eyebrow">OPERACIÓN EPS</span>
            <h1 id="epsTitle" tabindex="-1">Dashboard</h1>
            <p id="epsDescription">Gestión de la entidad EPS autenticada.</p>
          </div>
          <button id="refreshEps" class="btn-outline admin-refresh" type="button">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
            Actualizar
          </button>
        </section>
        <div id="epsMessage" class="admin-message" role="status" aria-live="polite"></div>
        <div id="epsAccess" role="status" aria-busy="true">Verificando permisos…</div>
        <div id="epsWorkspace" aria-busy="true"></div>
        <dialog id="epsDialog" aria-labelledby="epsDialogTitle">
          <div id="epsDialogContent"></div>
          <div class="eps-dialog-footer">
            <button id="epsCloseDialog" type="button" class="btn-outline">Cerrar</button>
          </div>
        </dialog>
      </main>
    </div>
  </div>

  <script is:inline type="module" src="/js/panel-menu.js"></script>
  <script is:inline type="module" src="/js/eps-convenios.js"></script>
</Layout>
