---
import Layout from "../../layouts/Layout.astro";
const title = "Historial | SaludClick";
const bodyClass = "";
---
<Layout title={title} bodyClass={bodyClass}>
  <Fragment slot="head">

  </Fragment>
  <header class="navbar">
      <div class="container nav-container">
        <div class="logo">
          <i class="fa-solid fa-heart-pulse"></i>
          <span>SaludClick</span>
        </div>

        <button
          type="button"
          class="menu-toggle"
          id="menuToggle"
          aria-label="Abrir menú"
        >
          <i class="fa-solid fa-bars"></i>
        </button>
        <nav id="menu">
          <a href="dashboard.html">Inicio</a>
          <a href="medicamentos.html">Medicamentos</a>
          <a href="pedidos.html">Pedidos</a>
          <a href="historial.html">Historial</a>
          <a href="perfil.html">Perfil</a>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="container">
        <div class="hero-texto">
          <span class="badge"> Historial de Solicitudes </span>

          <h1>Historial de Pedidos</h1>

          <p>
            Consulta todos los medicamentos que has solicitado anteriormente y
            revisa su estado final.
          </p>
        </div>
      </div>
    </section>

    <section class="servicios">
      <div class="historial-container">
        <div class="historial-header">
          <div>
            <h2>Historial General</h2>
            <p>Consulta tus pedidos realizados y su estado.</p>
          </div>

          <div class="historial-icon">
            <i class="fa-solid fa-clock-rotate-left"></i>
          </div>
        </div>

        <div class="historial-table-wrapper">
          <table class="historial-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Medicamentos</th>
                <th>Fecha</th>
                <th>Estado Final</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody id="tablaHistorial">
              <!-- Los pedidos se cargan mediante historial.js -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-container">
        <div class="footer-col">
          <div class="logo-footer">
            <i class="fa-solid fa-heart-pulse"></i><span>SaludClick</span>
          </div>
          <p>Tu bienestar, a un solo clic.</p>
        </div>
        <div class="footer-col">
          <p><i class="fa-solid fa-location-dot"></i> Medellín - Colombia</p>
          <p>
            <i class="fa-solid fa-shield-halved"></i> Plataforma de demostración
          </p>
        </div>
        <div class="footer-col">
          <p>Accesos rápidos</p>
          <div class="redes">
            <a href="dashboard.html" aria-label="Inicio"
              ><i class="fa-solid fa-house"></i></a
            ><a href="medicamentos.html" aria-label="Medicamentos"
              ><i class="fa-solid fa-pills"></i></a
            ><a href="pedidos.html" aria-label="Pedidos"
              ><i class="fa-solid fa-cart-shopping"></i></a
            ><a href="formulas.html" aria-label="Fórmulas"
              ><i class="fa-solid fa-file-medical"></i
            ></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 SaludClick · Todos los derechos reservados.</p>
      </div>
    </footer>

    <script is:inline type="module" src="/js/historial.js"></script>
    <script is:inline type="module" src="/js/menu.js"></script>
</Layout>
