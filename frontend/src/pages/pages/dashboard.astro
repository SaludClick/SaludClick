---
import Layout from "../../layouts/Layout.astro";
const title = "Dashboard | SaludClick";
const bodyClass = "dashboard-page";
---
<Layout title={title} bodyClass={bodyClass}>
  <Fragment slot="head">
    <!-- CSS PRINCIPAL -->


    <!-- FONT AWESOME -->


    <!-- FAVICON -->
  </Fragment>
  <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <header class="navbar dashboard-navbar" id="navbar">

        <div class="container nav-container">


            <!-- LOGO -->

            <a
                href="dashboard.html"
                class="logo"
                aria-label="Ir al inicio"
            >

                <i class="fa-solid fa-heart-pulse"></i>

                <span>SaludClick</span>

            </a>


            <!-- BOTÓN MENÚ MÓVIL -->

            <button
                type="button"
                class="menu-toggle"
                id="menuToggle"
                aria-label="Abrir menú"
                aria-expanded="false"
                aria-controls="menu"
            >

                <i class="fa-solid fa-bars"></i>

            </button>


            <!-- MENÚ -->

            <nav
                class="main-nav"
                id="menu"
                aria-label="Menú principal"
            >

                <a
                    href="dashboard.html"
                    class="nav-link active"
                >
                    <i class="fa-solid fa-house"></i>
                    <span>Inicio</span>
                </a>


                <a
                    href="medicamentos.html"
                    class="nav-link"
                >
                    <i class="fa-solid fa-pills"></i>
                    <span>Medicamentos</span>
                </a>


                <a
                    href="pedidos.html"
                    class="nav-link"
                >
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Pedidos</span>
                </a>


                <a
                    href="formulas.html"
                    class="nav-link"
                >
                    <i class="fa-solid fa-file-medical"></i>
                    <span>Fórmulas</span>
                </a>


                <a
                    href="historial.html"
                    class="nav-link"
                >
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>Historial</span>
                </a>


                <a
                    href="perfil.html"
                    class="nav-link"
                >
                    <i class="fa-solid fa-user"></i>
                    <span>Perfil</span>
                </a>


                <button
                    type="button"
                    class="nav-link logout-link"
                    id="logout"
                >

                    <i class="fa-solid fa-right-from-bracket"></i>

                    <span>Cerrar sesión</span>

                </button>

            </nav>

        </div>

    </header>



    <!-- =====================================================
         CONTENIDO PRINCIPAL
    ====================================================== -->

    <main class="dashboard-content">


        <!-- =================================================
             BIENVENIDA
        ================================================== -->

        <section class="dashboard-welcome">

            <div class="dashboard-welcome-content">

                <span class="dashboard-badge">

                    <i class="fa-solid fa-sparkles"></i>

                    Panel principal

                </span>


                <h1 id="bienvenida">
                    Bienvenido
                </h1>


                <p>
                    Gestiona tus medicamentos, pedidos y
                    fórmulas desde un solo lugar.
                </p>

            </div>


            <!-- USUARIO -->

            <div class="dashboard-user">

                <div class="dashboard-user-icon">

                    <i class="fa-solid fa-user"></i>

                </div>


                <div>

                    <span>Sesión iniciada como</span>

                    <strong id="nombreUsuario">
                        Usuario
                    </strong>

                </div>

            </div>

        </section>



        <!-- =================================================
             RESUMEN
        ================================================== -->

        <section class="dashboard-section">


            <div class="dashboard-section-header">

                <div>

                    <h2>
                        Resumen
                    </h2>

                    <p>
                        Consulta rápidamente la actividad de tu cuenta.
                    </p>

                </div>

            </div>


            <div class="dashboard-stats">


                <!-- PEDIDOS -->

                <article class="dashboard-stat">

                    <div class="dashboard-stat-icon">

                        <i class="fa-solid fa-truck"></i>

                    </div>


                    <div class="dashboard-stat-info">

                        <span>
                            Total de pedidos
                        </span>

                        <strong id="totalPedidos">
                            0
                        </strong>

                        <small>
                            Pedidos registrados
                        </small>

                    </div>

                </article>



                <!-- FORMULAS -->

                <article class="dashboard-stat">

                    <div class="dashboard-stat-icon">

                        <i class="fa-solid fa-file-medical"></i>

                    </div>


                    <div class="dashboard-stat-info">

                        <span>
                            Fórmulas médicas
                        </span>

                        <strong id="totalFormulas">
                            0
                        </strong>

                        <small>
                            Documentos registrados
                        </small>

                    </div>

                </article>



                <!-- PEDIDOS ACTIVOS -->

                <article class="dashboard-stat">

                    <div class="dashboard-stat-icon">

                        <i class="fa-solid fa-box"></i>

                    </div>


                    <div class="dashboard-stat-info">

                        <span>
                            Pedidos activos
                        </span>

                        <strong id="pedidosActivos">
                            0
                        </strong>

                        <small>
                            En proceso de atención
                        </small>

                    </div>

                </article>



                <!-- TOTAL PAGADO -->

                <article class="dashboard-stat">

                    <div class="dashboard-stat-icon">

                        <i class="fa-solid fa-wallet"></i>

                    </div>


                    <div class="dashboard-stat-info">

                        <span>
                            Total pagado
                        </span>

                        <strong id="totalGastado">
                            $0
                        </strong>

                        <small>
                            Pagos registrados
                        </small>

                    </div>

                </article>

            </div>

        </section>



        <!-- =================================================
             ACCESOS RÁPIDOS
        ================================================== -->

        <section class="dashboard-section">


            <div class="dashboard-section-header">

                <div>

                    <h2>
                        Accesos rápidos
                    </h2>

                    <p>
                        Accede directamente a los servicios principales.
                    </p>

                </div>

            </div>


            <div class="dashboard-actions">


                <!-- MEDICAMENTOS -->

                <a
                    href="medicamentos.html"
                    class="dashboard-action"
                >

                    <div class="dashboard-action-icon">

                        <i class="fa-solid fa-pills"></i>

                    </div>


                    <div class="dashboard-action-content">

                        <strong>
                            Medicamentos
                        </strong>

                        <span>
                            Consulta disponibilidad
                        </span>

                    </div>


                    <i class="fa-solid fa-arrow-right"></i>

                </a>



                <!-- PEDIDOS -->

                <a
                    href="pedidos.html"
                    class="dashboard-action"
                >

                    <div class="dashboard-action-icon">

                        <i class="fa-solid fa-truck"></i>

                    </div>


                    <div class="dashboard-action-content">

                        <strong>
                            Mis pedidos
                        </strong>

                        <span>
                            Consulta tus solicitudes
                        </span>

                    </div>


                    <i class="fa-solid fa-arrow-right"></i>

                </a>



                <!-- FORMULAS -->

                <a
                    href="formulas.html"
                    class="dashboard-action"
                >

                    <div class="dashboard-action-icon">

                        <i class="fa-solid fa-file-medical"></i>

                    </div>


                    <div class="dashboard-action-content">

                        <strong>
                            Fórmulas
                        </strong>

                        <span>
                            Gestiona tus fórmulas
                        </span>

                    </div>


                    <i class="fa-solid fa-arrow-right"></i>

                </a>



                <!-- HISTORIAL -->

                <a
                    href="historial.html"
                    class="dashboard-action"
                >

                    <div class="dashboard-action-icon">

                        <i class="fa-solid fa-clock-rotate-left"></i>

                    </div>


                    <div class="dashboard-action-content">

                        <strong>
                            Historial
                        </strong>

                        <span>
                            Consulta tus movimientos
                        </span>

                    </div>


                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>

        </section>



        <!-- =================================================
             INFORMACIÓN INFERIOR
        ================================================== -->

        <section class="dashboard-info-grid">


            <!-- ESTADO DE LA PLATAFORMA -->

            <article class="dashboard-info-card">


                <div class="dashboard-info-header">

                    <div>

                        <h2>
                            Estado de SaludClick
                        </h2>

                        <p>
                            Información de la plataforma
                        </p>

                    </div>


                    <span class="dashboard-status">

                        <span></span>

                        Activo

                    </span>

                </div>


                <div class="dashboard-service">

                    <div class="dashboard-service-icon">

                        <i class="fa-solid fa-shield-heart"></i>

                    </div>


                    <div>

                        <strong>
                            Plataforma disponible
                        </strong>

                        <p>
                            Los servicios están funcionando
                            correctamente.
                        </p>

                    </div>

                </div>


                <div class="dashboard-service-list">


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Medicamentos
                        </span>

                        <strong>
                            Disponible
                        </strong>

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Pedidos
                        </span>

                        <strong>
                            Disponible
                        </strong>

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Fórmulas
                        </span>

                        <strong>
                            Disponible
                        </strong>

                    </div>

                </div>

            </article>



            <!-- PERFIL -->

            <article class="dashboard-info-card">


                <div class="dashboard-info-header">

                    <div>

                        <h2>
                            Mi cuenta
                        </h2>

                        <p>
                            Administra tu información personal
                        </p>

                    </div>

                </div>


                <div class="dashboard-profile">

                    <div class="dashboard-profile-avatar">

                        <i class="fa-solid fa-user"></i>

                    </div>


                    <div>

                        <strong id="nombreUsuarioPanel">
                            Usuario
                        </strong>

                        <span>
                            Cuenta personal
                        </span>

                    </div>

                </div>


                <a
                    href="perfil.html"
                    class="dashboard-profile-button"
                >

                    <i class="fa-solid fa-user-gear"></i>

                    Administrar perfil

                </a>

            </article>

        </section>

    </main>



    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer id="contacto" class="footer">
        <div class="container footer-container">

            <!-- Columna 1: Info e Identidad -->
            <div class="footer-col brand-col">
                <div class="logo-footer">
                    <i class="fa-solid fa-heart-pulse"></i>
                    <span>SaludClick</span>
                </div>
                <p class="tagline">Tu bienestar, a un solo clic.</p>
            </div>

            <!-- Columna 2: Ubicación y Contacto -->
            <div class="footer-col contact-col">
                <p><i class="fa-solid fa-location-dot"></i> Medellín - Colombia</p>
                <p>
                    <i class="fa-solid fa-envelope"></i>
                    <a href="mailto:juandavidmospa12@gmail.com" class="email-link">juandavidmospa12@gmail.com</a>
                </p>
            </div>

            <!-- Columna 3: Enlaces Activos a Redes Sociales -->
            <div class="footer-col social-col">
                <p class="social-title">Síguenos en nuestras redes</p>
                <div class="redes">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="https://wa.me/573208447006" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 SaludClick - Todos los derechos reservados.</p>
        </div>
    </footer>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script is:inline
        type="module"
        src="/js/menu.js"
    ></script>

    <script is:inline
        type="module"
        src="/js/main.js"
    ></script>

    <script is:inline
        type="module"
        src="/js/dashboard.js"
    ></script>
</Layout>
