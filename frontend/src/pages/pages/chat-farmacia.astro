---
import Layout from '../../layouts/Layout.astro';
import FarmaciaChat from '../../components/FarmaciaChat.jsx';
// Include the stylesheet in the page build as well as the client-only island.
import '../../styles/farmacia-chat.css';
---
<Layout title="Chat con farmacia | SaludClick" bodyClass="farmacia-chat-body">
  <FarmaciaChat client:only="react" />
  <script is:inline type="module">
    import {checkAuthGuard,initAuth} from '/js/auth.js';
    if(checkAuthGuard()) initAuth();
  </script>
</Layout>
