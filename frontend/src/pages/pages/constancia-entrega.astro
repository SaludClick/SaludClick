---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Constancia de entrega | SaludClick" bodyClass="ad-workspace">
  <link slot="head" rel="stylesheet" href="/css/administrative.css" />
  <main class="ad-main">
    <p><a href="/pages/pedidos.html">Volver a mis pedidos</a></p>
    <h1>Constancia de entrega</h1>
    <p id="constanciaEstado" role="status"></p>
    <section class="ad-card" id="adjuntosEntrega" hidden>
      <h2>Documentos de la visita</h2>
      <ul id="adjuntosEntregaLista"></ul>
      <p id="adjuntosEntregaEstado" role="status"></p>
    </section>
    <form id="autorizarReceptor" class="ad-card" hidden>
      <label>Identificador de la cuenta del receptor<input name="receptor" type="number" min="1" max="2147483647" required /></label>
      <button type="submit">Autorizar receptor para esta visita</button>
    </form>
    <form id="confirmarEntrega" class="ad-card" hidden>
      <p id="constanciaVersion"></p>
      <label class="ad-check"><input name="tratamiento" type="checkbox" required /><span id="textoTratamiento"></span></label>
      <p id="cantidadesRecibidas"></p>
      <label class="ad-check"><input name="recepcion" type="checkbox" required /><span id="textoRecepcion"></span></label>
      <button class="ad-primary" type="submit">Confirmar documentos</button>
    </form>
    <section class="ad-card" id="copiasEntrega" hidden>
      <h2>Documentos confirmados</h2>
      <ul id="copiasEntregaLista"></ul>
    </section>
  </main>
  <script is:inline type="module" src="/js/constancia-entrega.js"></script>
</Layout>
