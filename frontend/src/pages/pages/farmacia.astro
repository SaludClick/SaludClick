---
import Layout from "../../layouts/Layout.astro";
import FarmaciaOperaciones from "../../components/FarmaciaOperaciones.astro";

const title = "Dashboard de Farmacia | SaludClick";
---

<Layout title={title} bodyClass="admin-console">
  <Fragment slot="head"><link rel="stylesheet" href="/css/farmacia.css" /></Fragment>
  <div class="admin-app">
    <aside class="admin-sidebar" id="menu" aria-label="Navegación de farmacia">
      <a href="/pages/farmacia.html" class="admin-brand" aria-label="SaludClick, dashboard de farmacia">
        <span class="admin-brand-mark">
          <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        </span>
        <span>SaludClick<small>FARMACIA</small></span>
      </a>

      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones de farmacia">
        <a class="admin-side-link active" href="#pedidosFarmacia" aria-current="page"><span>Pedidos</span></a>
        <a class="admin-side-link" href="#inventarioFarmacia"><span>Inventario</span></a>
        <a class="admin-side-link" href="/pages/chat-farmacia.html"><span>Chat</span></a>
        <a class="admin-side-link" href="/pages/perfil.html"><span>Perfil</span></a>
      </nav>

      <div class="admin-sidebar-bottom">
        <div class="admin-sidebar-user">
          <span class="admin-avatar"><i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i></span>
          <span><strong id="farmaciaUserName">Farmacia</strong><small>Personal de farmacia</small></span>
        </div>
        <button class="admin-logout" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="admin-menu-toggle"
          id="menuToggle"
          type="button"
          aria-label="Abrir menú de farmacia"
          aria-expanded="false"
          aria-controls="menu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="admin-topbar-copy">
          <span>SaludClick</span>
          <strong>Panel de farmacia</strong>
        </div>
        <div class="admin-topbar-status">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          Acceso de farmacia
        </div>
      </header>

      <main class="admin-content farmacia-main" id="farmaciaMain" hidden>
        <section class="admin-page-heading">
          <div>
            <span class="admin-eyebrow">OPERACIÓN DE FARMACIA</span>
            <h1>Panel de farmacia</h1>
            <p>Organiza los pedidos y consulta las existencias. Solo se avanzan pedidos con pago aprobado.</p>
          </div>
          <button id="refreshFarmacia" class="btn-outline admin-refresh" type="button">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
            Actualizar panel
          </button>
        </section>

        <div id="farmaciaMessage" class="admin-message" role="status" aria-live="polite"></div>

        <section aria-label="Pedidos por estado">
          <p>Totales del sistema por estado del pedido; no indican aprobación del pago.</p>
          <div class="farmacia-stats" id="farmaciaStats">
            {[
              ["APROBADA", "Por preparar"],
              ["PREPARANDO", "En preparación"],
              ["LISTA", "Listos"]
            ].map(([estado, label]) => (
              <button type="button" class="farmacia-stat" data-order-status={estado} aria-busy="true">
                <span>{label}</span><strong data-count>Cargando…</strong>
                <small data-count-message>Consultando total</small>
              </button>
            ))}
          </div>
          <button id="retryFarmaciaStats" type="button" hidden>Reintentar indicadores</button>
        </section>
        <FarmaciaOperaciones />
      </main>
    </div>
  </div>

  <script is:inline type="module" src="/js/menu.js"></script>
  <script is:inline type="module" src="/js/farmacia.js"></script>
</Layout>
