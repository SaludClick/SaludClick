---
import FarmaciaLayout from '../../layouts/FarmaciaLayout.astro';
---
<FarmaciaLayout modulo="dashboard" titulo="Dashboard" descripcion="Resumen de solicitudes y existencias. Los indicadores no autorizan una dispensación.">
  <section id="panelFarmacia" aria-labelledby="farmaciaResumenTitle">
    <h2 id="farmaciaResumenTitle">Solicitudes por estado</h2><p>Totales de la cola operativa. Selecciona un indicador para abrir su pantalla.</p>
    <div class="farmacia-stats">
      {[
        ['APROBADA', 'Por preparar', 'solicitudes'], ['PREPARANDO', 'En preparación', 'solicitudes'],
        ['LISTA', 'Listas', 'entregas'], ['ENTREGADA', 'Entregadas', 'entregas']
      ].map(([estado, texto, pantalla]) => <a class="farmacia-stat" href={`/pages/farmacia-${pantalla}.html?estado=${estado}`} data-dashboard-state={estado} aria-busy="true"><span>{texto}</span><strong data-count>—</strong><small data-count-message>Consultando total</small></a>)}
    </div>
    <p id="farmaciaDashboardOrdersStatus" role="status" aria-live="polite"></p><button id="retryFarmaciaStats" type="button" hidden>Reintentar indicadores</button>
  </section>
  <section aria-labelledby="farmaciaCatalogStatsTitle"><h2 id="farmaciaCatalogStatsTitle">Existencias</h2>
    <div class="farmacia-existencias-stats" id="farmaciaCatalogStats" aria-busy="true">
      {[['total', 'Medicamentos registrados'], ['disponibles', 'Con existencias disponibles'], ['agotados', 'Agotados']].map(([clave, texto]) => <article><strong data-dashboard-stock={clave}>—</strong><span>{texto}</span></article>)}
    </div>
    <p>Disponible significa estado disponible y stock positivo.</p><p id="farmaciaDashboardStockStatus" role="status" aria-live="polite"></p>
    <a href="/pages/farmacia-inventario.html">Consultar inventario</a>
  </section>
  <section id="integracionEPS" data-eps-integration class="card admin-dashboard-card"><h2>Integracion EPS</h2></section>
  <script is:inline type="module" src="/js/eps-integracion.js"></script>
</FarmaciaLayout>
