---
import UserHeader from '../../components/UserHeader.astro';
import PerfilFormulario from '../../components/PerfilFormulario.astro';
---
<!DOCTYPE html>
<html lang="es">

<head>
    <script is:inline src="/js/theme.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil | SaludClick</title>

    <!-- Estilos generales y FontAwesome -->
    <link rel="stylesheet" href="../css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/panel-menu.css">
    <link rel="stylesheet" href="/css/user-header.css">
    <link rel="stylesheet" href="/css/user-documents.css">
</head>

<body class="dashboard-page user-profile">

    <!-- BARRA DE NAVEGACIÓN -->
    <UserHeader />
    <header class="navbar" data-user-header-fallback>
        <div class="container nav-container">
            <a href="dashboard.html" class="logo">
                <i class="fa-solid fa-heart-pulse"></i>
                <span>SaludClick</span>
            </a>

            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
                <i class="fa-solid fa-bars"></i>
            </button>

            <nav id="menu">
                <a href="dashboard.html"><i class="fa-solid fa-house"></i> Inicio</a>
                <a href="medicamentos.html"><i class="fa-solid fa-pills"></i> Medicamentos</a>
                <a href="pedidos.html"><i class="fa-solid fa-cart-shopping"></i> Pedidos</a>
                <a href="formulas.html"><i class="fa-solid fa-file-medical"></i> Fórmulas</a>
                <a href="historial.html"><i class="fa-solid fa-clock-rotate-left"></i> Historial</a>
                <a href="perfil.html" class="active"><i class="fa-solid fa-user"></i> Perfil</a>
                <button type="button" class="logout-link" id="logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
                </button>
            </nav>
            <saludclick-theme-control></saludclick-theme-control>
        </div>
    </header>

    <main class="profile-main">
        <div class="profile-intro">
            <h1>Mi perfil</h1>
            <p>Consulta y actualiza los datos de tu cuenta.</p>
        </div>
        <section class="perfil-card" aria-labelledby="nombrePerfil">
            <div class="profile-header">
                <div class="profile-avatar" aria-hidden="true">
                    <svg class="user-document-icon" focusable="false"><use href="/images/user-icons.svg#user"></use></svg>
                </div>
                <h2 id="nombrePerfil">Datos de la cuenta</h2>
            </div>
            <PerfilFormulario personal />
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer-container">
            <div class="footer-col">
                <div class="logo-footer">
                    <i class="fa-solid fa-heart-pulse"></i>
                    <span>SaludClick</span>
                </div>
                <p>Tu bienestar, a un solo clic.</p>
            </div>
            <div class="footer-col">
                <p><i class="fa-solid fa-location-dot"></i> Medellín - Colombia</p>
                <p><i class="fa-solid fa-shield-halved"></i> Plataforma de demostración</p>
            </div>
            <div class="footer-col">
                <p>Accesos rápidos</p>
                <div class="redes">
                    <a href="dashboard.html" aria-label="Inicio"><i class="fa-solid fa-house"></i></a>
                    <a href="medicamentos.html" aria-label="Medicamentos"><i class="fa-solid fa-pills"></i></a>
                    <a href="pedidos.html" aria-label="Pedidos"><i class="fa-solid fa-cart-shopping"></i></a>
                    <a href="formulas.html" aria-label="Fórmulas"><i class="fa-solid fa-file-medical"></i></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 SaludClick · Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script is:inline type="module" src="../js/perfil.js"></script>
    <script is:inline type="module" src="../js/menu.js"></script>
    <script is:inline type="module" src="../js/main.js"></script>

</body>

</html>
