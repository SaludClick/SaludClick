
---
import Layout from "../../layouts/Layout.astro";

const title = "Gestión de cuentas | SaludClick";
const bodyClass = "admin-console";
---

<Layout title={title} bodyClass={bodyClass}>
  <Fragment slot="head">
    <meta
      name="description"
      content="Gestión administrativa de pacientes, farmacias y EPS de SaludClick."
    />
  </Fragment>

  <div class="admin-app">
    <aside class="admin-sidebar" id="menu" aria-label="Navegación administrativa">
      <a href="/pages/admin.html" class="admin-brand" aria-label="SaludClick, dashboard">
        <span class="admin-brand-mark">
          <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        </span>
        <span>SaludClick<small>ADMINISTRACIÓN</small></span>
      </a>

      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones de administración">
        <a class="admin-side-link" href="/pages/admin.html">
          <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
          <span>Dashboard</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html" data-account-role="">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          <span>Usuarios</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-pacientes.html">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
          <span>Pacientes</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html?rol=3" data-account-role="3">
          <i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i>
          <span>Farmacias</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html?rol=4" data-account-role="4">
          <i class="fa-solid fa-hospital" aria-hidden="true"></i>
          <span>EPS</span>
        </a>
      </nav>

      <div class="admin-sidebar-bottom">
        <div class="admin-sidebar-user">
          <span class="admin-avatar"><i class="fa-solid fa-user-shield" aria-hidden="true"></i></span>
          <span><strong id="adminUserName">Administrador</strong><small>Administrador general</small></span>
        </div>
        <button class="admin-logout logout-link" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="admin-menu-toggle"
          id="menuToggle"
          type="button"
          aria-label="Abrir menú de administración"
          aria-expanded="false"
          aria-controls="menu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="admin-topbar-copy">
          <span>SaludClick</span>
          <strong>Gestión de cuentas</strong>
        </div>
      </header>

  <main class="admin-content admin-page" id="adminMain">
        <div class="admin-content-container">
      <section class="page-header admin-page-header">
        <span class="badge">
          <i class="fa-solid fa-shield-halved"></i>
          Gestión administrativa
        </span>

        <h1>Gestión de cuentas</h1>

        <p>
          Consulta las cuentas de pacientes, farmacias y EPS. Las cuentas con
          pedidos o pagos registrados estarán protegidas contra eliminación.
        </p>

        <div class="admin-header-meta">
          <span>
            <i class="fa-solid fa-database"></i>
            Cuentas registradas en SaludClick
          </span>

          <button id="refreshAccounts" class="btn-outline" type="button">
            <i class="fa-solid fa-rotate"></i>
            Actualizar
          </button>
        </div>
      </section>

      <div
        id="accountsMessage"
        class="admin-message"
        role="status"
        aria-live="polite"
      ></div>

      <section
        id="createAccountSection"
        class="card admin-orders-card admin-section"
        hidden
      >
        <div class="admin-orders-header">
          <div>
            <span class="admin-eyebrow">NUEVA CUENTA</span>
            <h2>Crear usuario</h2>
            <p>Elige el rol que tendrá acceso a SaludClick.</p>
          </div>
        </div>

        <form id="createAccountForm" class="admin-create-form">
          <div class="admin-create-grid">
            <label class="admin-create-field" for="newAccountName">
              <span>Nombre completo</span>
              <input
                id="newAccountName"
                name="nombre"
                type="text"
                autocomplete="name"
                maxlength="201"
                required
              />
            </label>

            <label class="admin-create-field" for="newAccountEmail">
              <span>Correo electrónico</span>
              <input
                id="newAccountEmail"
                name="correo"
                type="email"
                autocomplete="email"
                maxlength="150"
                required
              />
            </label>

            <label class="admin-create-field" for="newAccountPassword">
              <span>Contraseña</span>
              <input
                id="newAccountPassword"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
              />
              <small>Mínimo 8 caracteres.</small>
            </label>

            <label class="admin-create-field" for="confirmAccountPassword">
              <span>Confirmar contraseña</span>
              <input
                id="confirmAccountPassword"
                name="confirmarPassword"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
              />
            </label>

            <label class="admin-create-field" for="newAccountRole">
              <span>Rol</span>
              <select id="newAccountRole" name="rol_id" required>
                <option value="">Selecciona un rol</option>
                <option value="2">Paciente</option>
                <option value="3">Farmacia</option>
                <option value="4">EPS</option>
              </select>
            </label>
          </div>

          <div
            id="createAccountMessage"
            class="admin-create-message"
            role="status"
            aria-live="polite"
            hidden
          ></div>

          <button id="createAccountSubmit" class="btn-primary" type="submit">
            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
            Crear cuenta
          </button>
        </form>
      </section>

      <section class="admin-stats" id="accountStats">
        <article class="admin-stat">
          <i class="fa-solid fa-spinner fa-spin"></i>
          <span>Cargando cuentas...</span>
        </article>
      </section>

      <section class="card admin-orders-card admin-section">
        <div class="admin-orders-header">
          <div>
            <span class="admin-eyebrow">DIRECTORIO DE CUENTAS</span>
            <h2>Pacientes, farmacias y EPS</h2>
            <p>Revisa los datos y el historial antes de tomar una decisión.</p>
          </div>
        </div>

        <div class="admin-filters">
          <label for="accountSearch">
            <span>Buscar cuenta</span>
            <div class="admin-input-wrap">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input
                id="accountSearch"
                type="search"
                placeholder="Nombre, correo o ID..."
                autocomplete="off"
              />
            </div>
          </label>

          <label for="accountTypeFilter">
            <span>Tipo de cuenta</span>
            <select id="accountTypeFilter">
              <option value="">Todos los tipos</option>
              <option value="2">Pacientes</option>
              <option value="3">Farmacias</option>
              <option value="4">EPS</option>
            </select>
          </label>
        </div>

        <p id="accountResults" class="admin-results" aria-live="polite">
          Preparando listado...
        </p>

        <div class="orders-table-wrapper">
          <table class="orders-table admin-orders-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Cuenta</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Pedidos</th>
                <th>Pagos</th>
                <th>Fórmulas</th>
                <th>Acción</th>
              </tr>
            </thead>

            <tbody id="accountsTable">
              <tr>
                <td colspan="8" class="admin-table-loading">
                  <i class="fa-solid fa-spinner fa-spin"></i>
                  Cargando cuentas...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="admin-table-footer">
          <span>
            <i class="fa-solid fa-circle-info"></i>
            Las cuentas con historial comercial no se pueden eliminar desde
            este panel.
          </span>
        </div>
      </section>
    </div>
  </main>
    </div>
  </div>

  <script is:inline type="module" src="/js/menu.js"></script>
  <script is:inline type="module" src="/js/admin-cuentas.js"></script>
</Layout>

<style>
  .admin-create-form {
    display: grid;
    gap: 1.25rem;
  }

  .admin-create-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .admin-create-field {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    color: #334155;
    font-weight: 600;
  }

  .admin-create-field input,
  .admin-create-field select {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid #dbe5df;
    border-radius: 0.65rem;
    background: #fff;
    color: #123b2a;
    font: inherit;
  }

  .admin-create-field input:focus,
  .admin-create-field select:focus {
    outline: 3px solid rgb(25 135 84 / 20%);
    border-color: #198754;
  }

  .admin-create-field small {
    color: #64748b;
    font-weight: 400;
  }

  .admin-create-message {
    padding: 0.75rem 1rem;
    border-radius: 0.65rem;
    background: #f1f8f5;
    color: #17633e;
  }

  .admin-create-message[data-tipo="error"] {
    background: #fff1f0;
    color: #b42318;
  }

  @media (max-width: 640px) {
    .admin-create-form > .btn-primary {
      width: 100%;
    }
  }
</style>
