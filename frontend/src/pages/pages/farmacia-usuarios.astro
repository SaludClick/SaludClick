---
import FarmaciaLayout from '../../layouts/FarmaciaLayout.astro';
---
<FarmaciaLayout modulo="usuarios" titulo="Usuarios" descripcion="Pacientes activos afiliados a tu única EPS vinculada. Consulta de solo lectura.">
  <section id="farmaciaUsuarios" aria-labelledby="usuariosFarmaciaTitle">
    <h2 id="usuariosFarmaciaTitle">Pacientes activos de <span id="farmaciaUsuariosEps">tu EPS</span></h2>
    <p>Total de pacientes activos autorizados para consulta: <strong id="farmaciaUsuariosTotal">—</strong></p>
    <form id="farmaciaUsuariosFilter" class="farmacia-filters">
      <div class="usuarios-filter-fields">
        <label for="farmaciaUsuariosBuscar">Buscar usuario
          <input id="farmaciaUsuariosBuscar" type="search" maxlength="150" placeholder="Nombre, documento o correo" disabled />
        </label>
        <label for="farmaciaUsuariosEstado">Estado
          <select id="farmaciaUsuariosEstado" disabled>
            <option value="">Todos</option>
            <option value="activos">Activos</option>
            <option value="inactivos">Inactivos</option>
          </select>
        </label>
      </div>
      <button id="farmaciaUsuariosBuscarButton" type="submit" disabled>Buscar</button><button id="farmaciaUsuariosClear" type="button" disabled>Limpiar</button>
    </form>
    <button id="farmaciaUsuariosRefresh" type="button">Actualizar consulta</button>
    <p id="farmaciaUsuariosStatus" role="status" aria-live="polite">Verificando EPS vinculada…</p>
    <div class="farmacia-table" id="farmaciaUsuariosTable" hidden><table class="farmacia-existencias-table"><caption>Pacientes activos autorizados · Fuente original EPS · Solo lectura</caption><thead><tr><th scope="col">Nombre</th><th scope="col">Apellidos</th><th scope="col">Tipo de documento</th><th scope="col">Documento</th><th scope="col">Correo</th><th scope="col">EPS</th><th scope="col">Estado</th><th scope="col">Identificador de afiliación</th></tr></thead><tbody id="farmaciaUsuariosRows" aria-busy="true"></tbody></table></div>
    <nav class="farmacia-pagination" aria-label="Páginas de pacientes activos"><button id="farmaciaUsuariosPrevious" type="button" disabled>Anterior</button><span id="farmaciaUsuariosPage"></span><button id="farmaciaUsuariosNext" type="button" disabled>Siguiente</button></nav>
  </section>
</FarmaciaLayout>

<style>
  .usuarios-filter-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, 12rem);
    gap: .75rem;
    width: 100%;
  }
  .usuarios-filter-fields label { display: grid; gap: .35rem; min-width: 0; }
  .usuarios-filter-fields :is(input, select) { width: 100%; min-width: 0; }
  @media (max-width: 480px) {
    .usuarios-filter-fields { grid-template-columns: minmax(0, 1fr); }
  }
</style>
