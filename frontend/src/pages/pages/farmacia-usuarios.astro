---
import FarmaciaLayout from '../../layouts/FarmaciaLayout.astro';
---
<FarmaciaLayout modulo="usuarios" titulo="Usuarios" descripcion="Pacientes activos afiliados a tu única EPS vinculada. Consulta de solo lectura.">
  <section id="farmaciaUsuarios" aria-labelledby="usuariosFarmaciaTitle">
    <h2 id="usuariosFarmaciaTitle">Pacientes activos de <span id="farmaciaUsuariosEps">tu EPS</span></h2>
    <p>Total de pacientes activos autorizados para consulta: <strong id="farmaciaUsuariosTotal">—</strong></p>
    <form id="farmaciaUsuariosFilter" class="farmacia-filters">
      <label for="farmaciaUsuariosBuscar">Nombre o apellidos</label><input id="farmaciaUsuariosBuscar" type="search" maxlength="150" disabled />
      <button id="farmaciaUsuariosBuscarButton" type="submit" disabled>Buscar</button><button id="farmaciaUsuariosClear" type="button" disabled>Limpiar</button>
    </form>
    <button id="farmaciaUsuariosRefresh" type="button">Actualizar consulta</button>
    <p id="farmaciaUsuariosStatus" role="status" aria-live="polite">Verificando EPS vinculada…</p>
    <div class="farmacia-table" id="farmaciaUsuariosTable" hidden><table class="farmacia-existencias-table"><caption>Pacientes activos autorizados</caption><thead><tr><th scope="col">Nombre</th><th scope="col">Apellidos</th><th scope="col">EPS</th><th scope="col">Estado</th></tr></thead><tbody id="farmaciaUsuariosRows" aria-busy="true"></tbody></table></div>
    <nav class="farmacia-pagination" aria-label="Páginas de pacientes activos"><button id="farmaciaUsuariosPrevious" type="button" disabled>Anterior</button><span id="farmaciaUsuariosPage"></span><button id="farmaciaUsuariosNext" type="button" disabled>Siguiente</button></nav>
  </section>
</FarmaciaLayout>
