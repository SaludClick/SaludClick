---
import Layout from "../../layouts/Layout.astro";

const title = "Pacientes autorizados | SaludClick";
const bodyClass = "admin-console";
---

<Layout title={title} bodyClass={bodyClass}>
  <Fragment slot="head">
    <meta
      name="description"
      content="Registro administrativo de pacientes autorizados de SaludClick."
    />
  </Fragment>

  <div class="admin-app">
    <aside class="admin-sidebar" id="menu" aria-label="Navegación administrativa">
      <a href="/pages/admin.html" class="admin-brand" aria-label="SaludClick, dashboard">
        <span class="admin-brand-mark">
          <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
        </span>
        <span>SaludClick<small>ADMINISTRACIÓN</small></span>
      </a>

      <span class="admin-nav-caption">MENÚ PRINCIPAL</span>
      <nav class="admin-side-nav" aria-label="Secciones de administración">
        <a class="admin-side-link" href="/pages/admin.html">
          <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
          <span>Dashboard</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          <span>Usuarios</span>
        </a>
        <a class="admin-side-link active" href="/pages/admin-pacientes.html" aria-current="page">
          <i class="fa-solid fa-user" aria-hidden="true"></i>
          <span>Pacientes</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html?rol=3">
          <i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i>
          <span>Farmacias</span>
        </a>
        <a class="admin-side-link" href="/pages/admin-cuentas.html?rol=4">
          <i class="fa-solid fa-hospital" aria-hidden="true"></i>
          <span>EPS</span>
        </a>
      </nav>

      <div class="admin-sidebar-bottom">
        <div class="admin-sidebar-user">
          <span class="admin-avatar"><i class="fa-solid fa-user-shield" aria-hidden="true"></i></span>
          <span><strong id="adminUserName">Administrador</strong><small>Administrador general</small></span>
        </div>
        <button class="admin-logout logout-link" id="logout" type="button">
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="admin-menu-toggle"
          id="menuToggle"
          type="button"
          aria-label="Abrir menú de administración"
          aria-expanded="false"
          aria-controls="menu"
        >
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="admin-topbar-copy">
          <span>SaludClick</span>
          <strong>Pacientes autorizados</strong>
        </div>
      </header>

      <main class="admin-content admin-page" id="adminMain">
        <div class="admin-content-container">
          <section class="page-header admin-page-header">
            <span class="badge">
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              Registro maestro
            </span>
            <h1>Pacientes autorizados</h1>
            <p>
              Registra y administra las personas autorizadas. Este registro es
              independiente de las cuentas de usuario y no crea cuentas.
            </p>
            <div class="admin-header-meta">
              <span>
                <i class="fa-solid fa-database" aria-hidden="true"></i>
                <span id="patientCount">Cargando pacientes...</span>
              </span>
              <button id="refreshPatients" class="btn-outline" type="button">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                Actualizar
              </button>
            </div>
          </section>

          <div id="patientsMessage" class="admin-message" role="status" aria-live="polite"></div>

          <section class="card admin-orders-card admin-section">
            <div class="admin-orders-header">
              <div>
                <span class="admin-eyebrow">REGISTRO AUTORIZADO</span>
                <h2 id="patientFormTitle">Registrar paciente</h2>
                <p>La información de identidad se guarda en el registro maestro.</p>
              </div>
            </div>

            <form id="patientForm" class="patient-form">
              <div class="patient-form-grid">
                <label for="patientFirstNames">
                  <span>Nombres</span>
                  <input id="patientFirstNames" name="nombres" type="text" maxlength="100" autocomplete="given-name" required />
                </label>
                <label for="patientLastNames">
                  <span>Apellidos</span>
                  <input id="patientLastNames" name="apellidos" type="text" maxlength="100" autocomplete="family-name" required />
                </label>
                <label for="patientDocumentType">
                  <span>Tipo de documento</span>
                  <input id="patientDocumentType" name="tipo_documento" type="text" maxlength="10" placeholder="CC" required />
                </label>
                <label for="patientDocument">
                  <span>Número de documento</span>
                  <input id="patientDocument" name="cedula" type="text" maxlength="30" autocomplete="off" required />
                </label>
                <label id="patientStatusField" for="patientStatus" hidden>
                  <span>Autorización</span>
                  <select id="patientStatus" name="estado" disabled>
                    <option value="AUTORIZADO">Autorizado</option>
                    <option value="REVOCADO">Revocado</option>
                  </select>
                </label>
              </div>
              <div id="patientFormMessage" class="patient-form-message" role="status" aria-live="polite" hidden></div>
              <div class="patient-form-actions">
                <button id="patientSubmit" class="btn-primary" type="submit">
                  <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                  Registrar paciente
                </button>
                <button id="patientCancelEdit" class="btn-outline" type="button" hidden>
                  Cancelar edición
                </button>
              </div>
            </form>
          </section>

          <section class="card admin-orders-card admin-section">
            <div class="admin-orders-header">
              <div>
                <span class="admin-eyebrow">DIRECTORIO</span>
                <h2>Pacientes registrados</h2>
                <p>Busca por nombres, apellidos o número de documento.</p>
              </div>
            </div>

            <div class="patient-filters">
              <label for="patientSearch">
                <span>Buscar paciente</span>
                <div class="admin-input-wrap">
                  <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                  <input id="patientSearch" type="search" maxlength="100" placeholder="Nombre o documento..." autocomplete="off" />
                </div>
              </label>
            </div>

            <p id="patientResults" class="admin-results" aria-live="polite">Preparando listado...</p>

            <div class="orders-table-wrapper">
              <table class="orders-table admin-orders-table patient-table">
                <thead>
                  <tr>
                    <th>Paciente</th>
                    <th>Documento</th>
                    <th>Autorización</th>
                    <th>Registro</th>
                    <th>Acción</th>
                  </tr>
                </thead>
                <tbody id="patientsTable">
                  <tr>
                    <td colspan="5" class="admin-table-loading">
                      <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
                      Cargando pacientes...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="patient-pagination" aria-label="Paginación de pacientes">
              <button id="previousPage" class="btn-outline" type="button" disabled>
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                Anterior
              </button>
              <span id="pageStatus" aria-live="polite">Página 1</span>
              <button id="nextPage" class="btn-outline" type="button" disabled>
                Siguiente
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
              </button>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <script is:inline type="module" src="/js/menu.js"></script>
  <script is:inline type="module" src="/js/admin-pacientes.js"></script>
</Layout>

<style>
  .patient-form {
    display: grid;
    gap: 1.1rem;
  }

  .patient-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
  }

  .patient-form-grid label,
  .patient-filters label {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    color: #334155;
    font-weight: 600;
  }

  .patient-form-grid input,
  .patient-form-grid select {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid #dbe5df;
    border-radius: 0.65rem;
    background: #fff;
    color: #123b2a;
    font: inherit;
  }

  .patient-form-grid :where(input, select):focus,
  .patient-filters input:focus {
    outline: 3px solid rgb(25 135 84 / 20%);
    border-color: #198754;
  }

  .patient-form-actions,
  .patient-pagination {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .patient-form-message:not([hidden]) {
    padding: 0.75rem 1rem;
    border-radius: 0.65rem;
    background: #f1f8f5;
    color: #17633e;
  }

  .patient-form-message[data-tipo="error"] {
    background: #fff1f0;
    color: #b42318;
  }

  .patient-filters {
    max-width: 460px;
    margin-bottom: 0.75rem;
  }

  .patient-table {
    min-width: 690px;
  }

  .patient-name {
    color: #173b31;
    font-weight: 700;
  }

  .patient-badge {
    display: inline-flex;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: #e8f7ef;
    color: #17633e;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .patient-badge[data-state="REVOCADO"] {
    background: #fff1f0;
    color: #b42318;
  }

  .patient-pagination {
    justify-content: flex-end;
    margin-top: 1rem;
    color: #526a5e;
    font-size: 0.875rem;
  }

  .patient-pagination button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  @media (max-width: 640px) {
    .patient-form-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .patient-form-actions button,
    .patient-pagination button {
      justify-content: center;
    }

    .patient-pagination {
      justify-content: space-between;
      gap: 0.35rem;
    }
  }
</style>
