---
import Layout from "../layouts/Layout.astro";
const title = "Nueva contraseña - SaludClick";
const bodyClass = "bg-light d-flex align-items-center justify-content-center min-vh-100";
---
<Layout title={title} bodyClass={bodyClass}>
  <Fragment slot="head">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </Fragment>
  <div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="text-center mb-4">
                <a href="index.html" class="text-success text-decoration-none">
                    <i class="fa-solid fa-heart-pulse fa-3x mb-3"></i>
                    <h2 class="fw-bold">SaludClick</h2>
                </a>
                <p class="text-muted">Tu bienestar, a un solo clic</p>
            </div>
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="text-center fw-bold mb-2">Crear nueva contraseña</h3>
                    <p class="text-center text-muted mb-4">Escribe tu nueva contraseña para recuperar el acceso.</p>
                    <form id="restablecerForm">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nueva contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" id="nuevaPassword" class="form-control" minlength="6" required placeholder="Mínimo 6 caracteres">
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Confirmar contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" id="confirmarPassword" class="form-control" minlength="6" required placeholder="Repite la contraseña">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-3 fw-bold rounded-3">
                            <i class="fa-solid fa-key me-2"></i> Cambiar contraseña
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script is:inline src="/js/restablecer.js"></script>
<footer class="footer auth-footer"><div class="container footer-container"><div class="footer-col"><div class="logo-footer"><i class="fa-solid fa-heart-pulse"></i><span>SaludClick</span></div><p>Tu bienestar, a un solo clic.</p></div><div class="footer-col"><p><i class="fa-solid fa-location-dot"></i> Medellín - Colombia</p><p><i class="fa-solid fa-shield-halved"></i> Plataforma de demostración</p></div><div class="footer-col"><p>Accesos</p><div class="redes"><a href="index.html" aria-label="Inicio"><i class="fa-solid fa-house"></i></a><a href="login.html" aria-label="Iniciar sesión"><i class="fa-solid fa-right-to-bracket"></i></a><a href="registro.html" aria-label="Registrarse"><i class="fa-solid fa-user-plus"></i></a></div></div></div><div class="footer-bottom"><p>© 2026 SaludClick · Todos los derechos reservados.</p></div></footer>
</Layout>
