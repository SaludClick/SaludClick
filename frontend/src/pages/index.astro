---
import VitalixWidget from "../components/VitalixWidget.jsx";
import '../styles/chat.css';

const servicios = [
    { nombre: 'Consultar Medicamentos', descripcion: 'Consulta disponibilidad en farmacias afiliadas.', accion: 'medicamentos', destino: '#catalogo-publico', etiqueta: 'Consultar', icono: 'prescription-bottle-medical' },
    { nombre: 'Solicitar Domicilio', descripcion: 'Recibe tus medicamentos en tu hogar.', accion: 'pedido', destino: '/pages/pedidos.html', etiqueta: 'Solicitar', icono: 'house' },
    { nombre: 'Seguimiento Pedido', descripcion: 'Consulta el estado de tu solicitud.', accion: 'historial', destino: '/pages/historial.html', etiqueta: 'Ver Estado', icono: 'clipboard-list' },
    { nombre: 'Cargar Fórmula', descripcion: 'Adjunta tu fórmula médica.', accion: 'formula', destino: '/pages/formulas.html', etiqueta: 'Cargar', icono: 'file-medical' },
    { nombre: 'Historial', descripcion: 'Consulta solicitudes anteriores.', accion: 'historial', destino: '/pages/historial.html', etiqueta: 'Ver Historial', icono: 'clock-rotate-left' },
    { nombre: 'Soporte', descripcion: 'Atención al cliente.', accion: 'contacto', destino: '/pages/chat.html', etiqueta: 'Contactar', icono: 'headset' },
];
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SaludClick - Tu bienestar, a un solo clic</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/portada-publica.css">
</head>

<body class="home-page">

    <header class="navbar home-navbar">
        <div class="container nav-container home-header-row">
            <a class="logo home-logo" href="#inicio" aria-label="SaludClick, Inicio">
                <i class="fa-solid fa-heart-pulse"></i>
                <span>SaludClick</span>
            </a>
            <nav id="menu" aria-label="Navegación principal">
                <div class="home-nav-links">
                    <a href="#inicio">Inicio</a>
                    <a href="#catalogo-publico">Medicamentos</a>
                    <a href="#servicios">Servicios</a>
                    <a href="#preguntas-frecuentes">Preguntas Frecuentes</a>
                    <a href="#contacto">Contacto</a>
                </div>
            </nav>
            <a href="/login.html" class="btn-primary home-login-link">Iniciar Sesión</a>
            <button
                class="menu-toggle home-menu-toggle"
                id="menuToggle"
                type="button"
                aria-controls="menu"
                aria-expanded="false"
                aria-label="Abrir menú de navegación"
            >
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    <main>
    <section id="inicio" class="hero home-hero">
        <div class="container hero-content">
            <div class="hero-texto">
                <h1>Tu bienestar, a un solo clic</h1>
                <p>Consulta medicamentos, envía tus solicitudes y sigue cada paso desde un mismo lugar.</p>
                <div class="hero-botones">
                    <a href="#catalogo-publico" class="btn-primary btn-lg">Consultar Medicamentos</a>
                    <a href="#servicios" class="btn-outline btn-lg">Conocer Servicios</a>
                </div>
            </div>
            <img class="home-hero-photo" src="/images/portada-farmacia.jpg" alt="Profesional en una farmacia" width="1536" height="1024" fetchpriority="high">
        </div>
    </section>

    <section class="container portada-busqueda" role="search" aria-label="Buscar medicamentos">
        <label for="busquedaInicio">Buscar medicamentos</label>
        <div class="buscador home-search">
            <input id="busquedaInicio" type="search" maxlength="150" placeholder="Escribe el nombre del medicamento">
            <button id="buscarInicio" type="button"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Buscar</button>
        </div>
    </section>

    <section id="catalogo-publico" class="container catalogo-publico" aria-labelledby="catalogo-publico-titulo" tabindex="-1">
        <h2 id="catalogo-publico-titulo">Medicamentos disponibles</h2>
        <p id="catalogo-publico-estado" role="status">Cargando medicamentos…</p>
        <div id="catalogo-publico-lista" class="catalogo-publico-lista" aria-busy="true"></div>
        <nav class="catalogo-publico-paginacion" aria-label="Páginas del catálogo">
            <button id="catalogo-publico-anterior" type="button" class="btn-outline" disabled>Anterior</button>
            <button id="catalogo-publico-siguiente" type="button" class="btn-outline" disabled>Siguiente</button>
        </nav>
        <a id="catalogo-publico-completo" class="btn-outline" href="/index.html#catalogo-publico">Ver catálogo completo</a>
    </section>

    <section id="servicios" class="servicios" aria-labelledby="servicios-titulo">
        <div class="container servicios-panel">
            <header class="servicios-encabezado">
                <h2 id="servicios-titulo">Servicios Disponibles</h2>
                <p>Accede a las principales funcionalidades de SaludClick</p>
            </header>
            <div class="grid-servicios">
                {servicios.map(({ nombre, descripcion, accion, destino, etiqueta, icono }) => (
                    <article class="servicio-tarjeta">
                        <span class="servicio-icono" aria-hidden="true">
                            <i class={`fa-solid fa-${icono}`}></i>
                        </span>
                        <h3>{nombre}</h3>
                        <p>{descripcion}</p>
                        <a href={destino} data-action={accion} aria-label={`${etiqueta}: ${nombre}`} title={etiqueta}>
                            {etiqueta}
                        </a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="preguntas-frecuentes" class="container portada-faq">
        <h2>Preguntas frecuentes</h2>
        <details>
            <summary>¿Cómo consulto un medicamento?</summary>
            <p>Escribe su nombre en el buscador o revisa el catálogo público y su estado de disponibilidad.</p>
        </details>
        <details>
            <summary>¿Cómo adjunto una fórmula o reviso una solicitud?</summary>
            <p>Inicia sesión y usa los accesos de fórmulas o historial desde tu cuenta.</p>
        </details>
        <details>
            <summary>¿Dónde puedo pedir ayuda?</summary>
            <p><a href="/pages/chat.html">Atención directa desde VITALIX</a></p>
        </details>
    </section>

    <section id="beneficios" class="beneficios" aria-label="Beneficios de SaludClick">
        <div class="container beneficios-grid">
            <div class="beneficio"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Seguridad y confianza</div>
            <div class="beneficio"><i class="fa-solid fa-laptop" aria-hidden="true"></i> Gestión en línea</div>
            <div class="beneficio"><i class="fa-solid fa-truck" aria-hidden="true"></i> Entrega a domicilio</div>
            <div class="beneficio"><i class="fa-solid fa-headset" aria-hidden="true"></i> Soporte y acompañamiento</div>
        </div>
    </section>
    </main>

    <!-- Footer Optimizado con Redes Interactivas -->
    <footer id="contacto" class="footer">
        <div class="container footer-container">
            
            <!-- Columna 1: Info e Identidad -->
            <div class="footer-col brand-col">
                <div class="logo-footer">
                    <i class="fa-solid fa-heart-pulse"></i>
                    <span>SaludClick</span>
                </div>
                <p class="tagline">Tu bienestar, a un solo clic.</p>
            </div>

            <!-- Columna 2: Ubicación y Contacto -->
            <div class="footer-col contact-col">
                <p><i class="fa-solid fa-location-dot"></i> Medellín - Colombia</p>
                <p>
                    <i class="fa-solid fa-envelope"></i> 
                    <a href="/pages/chat.html" class="email-link">Atención directa desde VITALIX</a>
                </p>
            </div>

            <!-- Columna 3: Enlaces Activos a Redes Sociales -->
            <div class="footer-col social-col">
                <p class="social-title">Síguenos en nuestras redes</p>
                <div class="redes">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="https://wa.me/573208447006" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 SaludClick - Todos los derechos reservados.</p>
        </div>
    </footer>

    <script is:inline type="module" src="/js/menu.js"></script>
    <script is:inline type="module" src="/js/main.js"></script>
    <script is:inline type="module" src="/js/catalogo-publico.js"></script>
    <VitalixWidget client:load />
</body>

</html>
